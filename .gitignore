# Build outputs and portable packages
/build/
/build-*/
/cmake-build-*/
/out/
/dist/
/benchmarks/rust/target/

# Locally downloaded toolchains and dependencies
/.tools/
/.venv/
/venv/

# CMake/Ninja files generated by an in-source build
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/CTestTestfile.cmake
/Testing/
/build.ninja
/.ninja_deps
/.ninja_log
/compile_commands.json
/CMakeUserPresets.json

# Compiled native artifacts and debugging files
*.exe
*.dll
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.exp
*.idb
*.ipch
*.pch
*.res
*.tlog
*.launched

# Python caches, test caches and coverage output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Machine-specific editor state
/.vs/
/.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# Environment files; keep shareable templates
.env
.env.*
!.env.example
!.env.template

# Logs, temporary files and OS metadata
*.log
*.tmp
*.temp
*.bak
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Generated design exploration (not runtime assets)
/docs/design-options/

# Keep source/tests/build scripts, CMakePresets.json, Cargo.lock,
# the current/documented UI previews, and small benchmark evidence in docs/.
plan.md
